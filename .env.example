# Credentials issued by HBL when your merchant account is provisioned.
HBL_MERCHANT_ID=your_merchant_id
HBL_API_PASSWORD=your_api_password

# Optional. Defaults to HBL's production gateway.
# Use the test host HBL gives you during integration.
HBL_GATEWAY_HOST=ap-gateway.mastercard.com

# Optional. Shown to the customer on the hosted payment page.
HBL_MERCHANT_NAME=Your Business Name
